fn main$:
    // for, indented
    let mut s = 0
    for i in 0..4:
        s += i
    // for, inline
    for i in 0..3: s += i
    // for over a pattern
    let pairs = vec! [(1, 2), (3, 4)]
    for (a, b) in &pairs: s += a * b
    // while, indented
    let mut n = 0
    while n < 3:
        n += 1
    // while let
    let mut st = vec! [1, 2, 3]
    let mut popped = 0
    while let Some top = st <- pop$: popped += top
    // loop with break value
    let mut k = 0
    let found = loop:
        k += 1
        if k == 5: break k * 10
    // labelled loop
    let mut hits = 0
    'outer: for i in 0..3:
        for j in 0..3:
            if i * j == 2: continue 'outer
            hits += 1
    // braced
    let mut w = 0
    for i in 0..2 { w += i }
    println! "{s} {n} {popped} {found} {hits} {w}"
