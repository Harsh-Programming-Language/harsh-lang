fn sub (a: i32) (b: i32) (c: i32) -> i32:
    a - b - c

fn one x: i32 -> i32:
    x * 10

fn apply2 (f: impl Fn i32 i32 -> i32) (a: i32) (b: i32) -> i32:
    f a b

fn main$:
    let sub3 = 3 |> sub
    let sub3_5 = 5 |> sub3
    let r = sub3_5 100
    let s = sub3 5 100
    let t = 5 |> (3 |> sub)
    let u = apply2 sub3 5 100
    // a function is already a value; nothing to defer
    let v = one
    println! "{r} {s} {} {u} {}" (t 100) (v 4)
