fn add_fancy_hat$:
    println! "fancy hat"
fn remove_fancy_hat$:
    println! "no hat"
fn move_player spaces: u8:
    println! "move {} spaces" spaces

fn main$:
    for dice_roll in [3, 7, 4]:
        match dice_roll:
            3 => add_fancy_hat$
            7 => remove_fancy_hat$
            other => move_player other

    // when the value is not needed, `_` matches anything and binds nothing

    let roll = 9

    match roll:
        3 => add_fancy_hat$
        7 => remove_fancy_hat$
        _ => ()
