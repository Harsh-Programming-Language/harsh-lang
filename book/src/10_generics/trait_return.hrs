pub trait Summary:
    fn summarize (&self) -> String

pub struct Tweet
    pub username: String

impl Summary for Tweet:
    fn summarize (&self) -> String:
        format! "@{}" (self <- username)

fn returns_summarizable$ -> impl Summary:
    Tweet\ username = String.from "horse_ebooks"

fn main$:
    println! "{}" (returns_summarizable$ <- summarize$)
