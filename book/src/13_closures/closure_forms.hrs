fn add_one_v1 x: u32 -> u32:
    x + 1

fn main$:
    let add_one_v2 = |x: u32| -> u32:      // fully annotated, block body
        x + 1

    let add_one_v3 = |x| x + 1               // inferred, expression body

    let add_one_v4 = |x|:                    // inferred, block body
        x + 1

    println!
        "{} {} {} {}"
        (add_one_v1 1)
        (add_one_v2 2)
        (add_one_v3 3)
        (add_one_v4 4)
