use dioxus.prelude.*

use crate.components.( Editor, spans, tidy)
use crate.samples.*
use harsh_lang.driver.( convert_str, transpile_str)

/// The online converter, both ways (the user, 2026-09-27): Harsh to Rust
/// with the transpiler, Rust to Harsh with the converter `hrs-from` uses
/// (`driver::convert_str`), both compiled to WebAssembly with the site. What
/// you type on the left is converted on the right as you type; choosing the
/// other direction turns the output into the input (`turn`); Run opens the Rust side --
/// the output one way, the input the other -- on play.rust-lang.org.
#[component]
pub fn Converter$ -> Element:
    let mut src = use_signal (|| HERO_HARSH <- to_string$)
    let mut to_rust = use_signal (|| true)
    let code: String = src <- read$ <- clone$
    let forward = to_rust$
    let converted = if forward: transpile_str (&code) else: convert_str (&code)
    let (out, ok) = match converted\
        Ok text => (text, true)
        Err e => (e, false)
    let rust_side = if forward: out <- clone$ else: code <- clone$
    let run = format! "https://play.rust-lang.org/?version=stable&edition=2021&code={}" (encode (&rust_side))
    // What the other direction starts from: the output, as its input.
    let for_rust = out <- clone$
    let for_harsh = out <- clone$
    let (from, into) = if forward: ("Harsh", "Rust") else: ("Rust", "Harsh")
    let (from_lang, into_lang) = if forward: ("harsh", "rust") else: ("rust", "harsh")
    rsx! {
        section { class: "page play",
            h1 { "Converter" }
            p {
                "Harsh to Rust, or Rust to Harsh -- the transpiler and the converter "
                "themselves, running in your browser; the Harsh a Rust file becomes here "
                "is what " code { "hrs-from" } " writes. Run opens the Rust side on the "
                "Rust Playground. For the matrix sample, use the Playground, which sends "
                "the part of " code { "hrs_std" } " a program uses along with it."
            }
            div { class: "examples",
                // The two directions. The one in use is lit; choosing the other
                // turns the output into the input, so the text always matches the
                // direction. While the output is an error there is nothing to
                // turn back, so the other direction waits.
                button {
                    class: @: if forward: "chip on" else: "chip" :@,
                    disabled: !forward && !ok,
                    title: @: if !forward && !ok: FIX_FIRST else: "" :@,
                    onclick: @: move |_| turn src to_rust true (for_rust <- clone$) ok :@,
                    "Harsh → Rust"
                }
                button {
                    class: @: if forward: "chip" else: "chip on" :@,
                    disabled: forward && !ok,
                    title: @: if forward && !ok: FIX_FIRST else: "" :@,
                    onclick: @: move |_| turn src to_rust false (for_harsh <- clone$) ok :@,
                    "Rust → Harsh"
                }
            }
            div { class: "examples",
                for (name, harsh, rust) in @: EXAMPLES :@ {
                    button {
                        class: "chip",
                        onclick: @: move |_| src <- set (sample forward harsh rust) :@,
                        "{name}"
                    }
                }
                if forward {
                    button { class: "chip", onclick: @: move |_| tidy src :@, "Format" }
                }
            }
            div { class: "compare play-panes",
                div { class: "pane",
                    div { class: "pane-label", "{from}"
                        if !forward {
                            a { class: "run", href: "{run}", target: "_blank", rel: "noopener", "Run ↗" }
                        }
                    }
                    Editor { value: src, id: "converter-editor", lang: from_lang }
                }
                div { class: "pane",
                    div { class: "pane-label",
                        "{into}"
                        if ok && forward {
                            a { class: "run", href: "{run}", target: "_blank", rel: "noopener", "Run ↗" }
                        }
                    }
                    pre { class: @: if ok: format! "code {into_lang}" else: "code error" <- to_string$ :@,
                        code {
                            if ok { {@: spans (&out) :@} } else { "{out}" }
                        }
                    }
                }
            }
        }
    }

/// The samples the chips load: each in Harsh and in Rust.
const EXAMPLES: &[(&str, &str, &str)] = &[
    ("Word count", HERO_HARSH, HERO_RUST),
    ("Pipes", PIPES_HARSH, PIPES_RUST),
    ("Comprehensions", COMPREHENSIONS_HARSH, COMPREHENSIONS_RUST),
    ("Linear algebra", LINALG_HARSH, LINALG_RUST),
]

/// A sample, in the language the input is in.
fn sample (forward: bool) (harsh: &str) (rust: &str) -> String:
    if forward:
        harsh <- to_string$
    else:
        rust <- to_string$

/// Choosing a direction: the one in use does nothing; the other turns the
/// output into the input, and the direction with it -- so the input is always
/// in the language its direction reads. Never with an error as the output:
/// its button is disabled then (`FIX_FIRST`).
fn turn (mut src: Signal<String>) (mut to_rust: Signal<bool>) (want_rust: bool) (output: String) (ok: bool):
    if to_rust$ == want_rust || !ok:
        return
    src <- set output
    to_rust <- set want_rust

/// Why the other direction waits while the output is an error.
const FIX_FIRST: &str = "Fix the error first: there is nothing to convert back"

/// Percent-encode text for a URL's query string.
fn encode s: &str -> String:
    let mut out = String.new$
    for b in s <- bytes$:
        match b\
            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'_' | b'.' | b'~' => out <- push (b as char)
            _ => out <- push_str (&format! "%{:02X}" b)
    out
