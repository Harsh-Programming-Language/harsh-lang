{
  "name": "harsh-lang",
  "displayName": "Harsh",
  "description": "Rust without the braces: highlighting, layout-aware Enter and Tab, format on save, and errors on your .hrs lines, for the Harsh language.",
  "version": "0.1.4",
  "publisher": "harsh-lang",
  "author": "Bahiminin Benoit Dah",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "harsh",
        "aliases": [
          "Harsh",
          "harsh"
        ],
        "extensions": [
          ".hrs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "harsh",
        "scopeName": "source.harsh",
        "path": "./syntaxes/harsh.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Harsh",
      "properties": {
        "harsh.serverPath": {
          "type": "string",
          "default": "hrs-lsp",
          "description": "Path to the hrs-lsp binary. Leave empty and the extension looks on your PATH and where `cargo install harsh-lang` puts it (~/.cargo/bin); set it when the binary is elsewhere."
        }
      }
    },
    "configurationDefaults": {
      "[harsh]": {
        "editor.formatOnType": true,
        "editor.autoIndent": "keep",
        "files.trimTrailingWhitespace": true
      }
    },
    "commands": [
      {
        "command": "harsh.tab",
        "title": "Harsh: Indent to next legal column"
      },
      {
        "command": "harsh.shiftTab",
        "title": "Harsh: Indent to previous legal column"
      },
      {
        "command": "harsh.enter",
        "title": "Harsh: New line at the layout's column"
      }
    ],
    "keybindings": [
      {
        "command": "harsh.tab",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == harsh && !editorHasSelection && !suggestWidgetVisible && !inSnippetMode && !editorReadonly"
      },
      {
        "command": "harsh.shiftTab",
        "key": "shift+tab",
        "when": "editorTextFocus && editorLangId == harsh && !editorHasSelection && !suggestWidgetVisible && !inSnippetMode && !editorReadonly"
      },
      {
        "command": "harsh.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == harsh && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible && !renameInputVisible && !editorReadonly"
      }
    ]
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/bahiminin.benoit.dah.opensource/harsh-lang"
  },
  "keywords": [
    "harsh",
    "rust",
    "indentation",
    "transpiler",
    "language server"
  ],
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:harsh"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0e1418",
    "theme": "dark"
  }
}
