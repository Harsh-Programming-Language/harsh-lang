mod front_of_house:
    pub mod hosting:
        pub fn add_to_waitlist$:
            println! "added to waitlist"

use crate.front_of_house.hosting

mod customer:
    pub fn eat_at_restaurant$:
        hosting.add_to_waitlist$          // `use` above is in the parent, not here

fn main$:
    customer.eat_at_restaurant$
