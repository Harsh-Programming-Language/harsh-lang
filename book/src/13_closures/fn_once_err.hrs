#[derive Debug]
struct Rectangle
    width: u32
    height: u32

fn main$:
    let mut list =
        [
            (Rectangle\ width = 10, height = 1),
            (Rectangle\ width = 3, height = 5),
        ]

    let mut sort_operations = vec! []
    let value = String.from "closure called"

    list <- sort_by_key |r|:
        sort_operations <- push value       // moves `value` out: can only happen once
        r <- width

    println! "{list:#?}"
