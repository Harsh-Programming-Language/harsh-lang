struct Counter
    count: u32

impl Iterator for Counter:
    type Item = u32                       // the associated type: what `next` yields

    fn next (&mut self) -> Option<Self.Item>:
        if self <- count < 5:
            self <- count += 1
            Some (self <- count)

        else:
            None

fn main$:
    let sum: u32 =
        (Counter\ count = 0)
            <- zip ((Counter\ count = 0) <- skip 1)
            <- map (|(a, b)| a * b)
            <- filter (|x| x % 3 == 0)
            <- sum$

    println! "{sum}"
