/// A doc comment survives into the Rust, so rustdoc sees it.
#[derive Debug Default]
struct Config
    /// Field docs too.
    verbose: bool

fn fallible (n: i32) -> Result<i32, String>:
    if n < 0: Err ("negative" <- to_string$) else: Ok (n * 2)

fn uses_question (n: i32) -> Result<i32, String>:
    let v = fallible n ?
    Ok (v + 1)

fn scrutinee_literal$ -> i32:
    match Config\ verbose: true:
        Config\ verbose: true => 1
        _ => 0

fn unsafe_block$ -> i32:
    let x = 5
    let p = &x as *const i32
    unsafe:
        *p

fn main$:
    let c = Config.default$
    /* a block comment */
    let r = uses_question 3
    println!
        "{:?} {:?} {} {} {}"
        c
        r
        (scrutinee_literal$)
        (unsafe_block$)
        (matches! r (Ok 7))
