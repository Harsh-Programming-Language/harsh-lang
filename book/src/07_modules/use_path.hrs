mod front_of_house:
    pub mod hosting:
        pub fn add_to_waitlist$:
            println! "added to waitlist"

use crate.front_of_house.hosting          // bring the module in, not the function

fn eat_at_restaurant$:
    hosting.add_to_waitlist$              // the parent says where it came from

fn main$:
    eat_at_restaurant$
