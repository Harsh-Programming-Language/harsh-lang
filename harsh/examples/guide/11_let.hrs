struct P
    x: i32
    y: i32

fn get$ -> Option<i32>:
    Some 5

fn main$:
    // plain, typed, mutable
    let a = 1
    let b: i64 = 2
    let mut c = 3
    c += 1
    // destructuring a tuple, a struct, a pattern
    let (d, e) = (4, 5)
    let P\ x, y = P\ x = 6, y = 7
    let Some f = get$
        else:
            return
    // shadowing
    let a = a + 100
    // block as a value
    let g =
        do:
            let t = 2
            t * t
    // inline block as a value
    let h = { let u = 3; u * u }
    println! "{a} {b} {c} {d} {e} {x} {y} {f} {g} {h}"
