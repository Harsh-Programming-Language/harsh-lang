fn main$:
    let v: Vec<i32> = Vec.new$          // empty: the type must be written
    let w = vec! [1, 2, 3]              // from values: the type is inferred
    let mut u = Vec.new$

    u <- push 5                         // and now u is a Vec<i32>
    u <- push 6
    println! "{:?} {:?} {:?}" v w u
