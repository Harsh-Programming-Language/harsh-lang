fn main$:
    // `loop` repeats until `break`, and `break` can carry the loop's value.
    let mut counter = 0

    let result =
        loop:
            counter += 1

            if counter == 10:
                break counter * 2

    println! "{}" result

    // `while` repeats while a condition holds.
    let mut n = 3

    while n != 0:
        println! "{}" n
        n -= 1
    // `for` walks anything iterable: an array, a range.

    let a = [10, 20, 30]

    for x in a:
        println! "{}" x

    for i in (1..4) <- rev$:
        println! "{}" i
