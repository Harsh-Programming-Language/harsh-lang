#[derive Debug Clone]
enum Shape
    Empty
    Circle f64
    Rect f64 f64
    Named\
        name: String
        sides: u32

fn indented (s: &Shape) -> String:
    match s:
        Shape.Empty => "empty" <- to_string$
        Shape.Circle r => format! "circle {r}"
        Shape.Rect w h =>
            let area = w * h
            format! "rect {area}"
        Shape.Named\ name, sides => format! "{name}/{sides}"

fn inline (n: i32) -> &'static str:
    match n: 0 => "zero", 1 | 2 => "small", _ => "big"

fn braced (n: i32) -> &'static str:
    match n { 0 => "zero", _ => "other" }

fn guards (n: i32) -> &'static str:
    match n:
        x if x < 0 => "neg"
        0 => "zero"
        x if x % 2 == 0 => "even"
        _ => "odd"

fn as_value (n: i32) -> i32:
    let r = match n:
        1 => 10
        _ => 20
    r

fn nested (a: Option<i32>) (b: Option<i32>) -> i32:
    match a:
        Some x =>
            match b:
                Some y => x + y
                None => x
        None => 0

fn tuple_pat (p: (i32, i32)) -> i32:
    match p:
        (0, y) => y
        (x, 0) => x
        (x, y) => x * y

fn ranges (n: u8) -> &'static str:
    match n:
        0..=9 => "digit"
        b'a'..=b'z' => "lower"
        _ => "other"

fn binding (n: i32) -> String:
    match n:
        v @ 1..=5 => format! "low {v}"
        v => format! "hi {v}"

fn main$:
    let shapes =
        vec! [Shape.Empty, (Shape.Circle 2.0), (Shape.Rect
                                                    2.0
                                                    3.0), (Shape.Named\ name = "hex" <- to_string$, sides = 6)]
    for s in &shapes: print! "{} " (indented s)
    println! ""
    println!
        "{} {} {} {} {} {} {} {}"
        (inline 1)
        (braced 0)
        (guards 4)
        (as_value 1)
        (nested (Some 2) (Some 3))
        (tuple_pat (0, 7))
        (ranges 65)
        (binding 3)
