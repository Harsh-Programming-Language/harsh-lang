fn main$:
    let a = 5
    let r: Result<i32, ()> = Ok 7
    let m1 = matches! a (1..=9)
    let m2 = matches! a (n if n > 3)
    let m3 = matches! r (Ok 7)
    let m4 = matches! a (1 | 2 | 5)
    assert! (a == 5)
    assert_eq! a 5
    let v = vec! [1, 2, 3]
    let z = vec! [0u8; 4]
    println! "{m1} {m2} {m3} {m4} {:?} {:?}" v z
