use dioxus.prelude.*

use crate.components.Code

const INSTALL: &str = r#"cargo install harsh-lang
hrs --version"#

const NEW: &str = r#"hrs new hello
cd hello
hrs run"#

const MAIN: &str = r#"fn main$:
    println! "Hello, world!""#

const COMMANDS: &str = r#"hrs build      transpile src/**.hrs to target/hrs/, then cargo build
hrs run        build and run, diagnostics on the .hrs lines
hrs test       cargo test, remapped
hrs check      cargo check, remapped
hrs lint       clippy, remapped
hrs fmt        the formatter
hrs watch      rebuild on every save
hrs export     the project as pure Rust, nothing of Harsh left in it
hrs-from       convert a Rust file or project to Harsh"#

const VSCODE: &str = r#"code --install-extension harsh-lang.harsh-lang"#

const JUPYTER: &str = r#"cargo install evcxr_jupyter
evcxr_jupyter --install
python -m pip install harsh-kernel
python -m harsh_kernel.install"#

const HARSHLINGS: &str = r#"git clone https://gitlab.com/bahiminin.benoit.dah.opensource/harshlings
cd harshlings
hrs run"#

#[component]
pub fn Install$ -> Element:
    rsx! {
        section { class: "page",
            h1 { "Install" }
            p {
                "Harsh needs a Rust toolchain -- "
                a { href: "https://rustup.rs", target: "_blank", rel: "noopener", "rustup" }
                " -- and one " code { "cargo install" } ". The package is " code { "harsh-lang" }
                "; it installs " code { "hrs" } ", " code { "hrs-from" } ", " code { "hrs-remap" }
                " and " code { "hrs-lsp" } "."
            }
            Code { code: INSTALL, lang: "shell" }

            h2 { "A first project" }
            p {
                code { "hrs new" } " writes a project whose " code { "Cargo.toml" }
                " points at " code { "target/hrs/" } ", where the generated Rust goes. "
                "Your sources are " code { "src/**.hrs" } "; dependencies are Cargo's, unchanged."
            }
            Code { code: NEW, lang: "shell" }
            Code { code: MAIN, lang: "harsh" }

            h2 { "The commands" }
            Code { code: COMMANDS, lang: "shell" }

            h2 { "The toolset" }
            p {
                "Everything Harsh offers beside the compiler's commands, and where it stands."
            }

            h3 { "VS Code" }
            p {
                "The extension "
                a { href: "https://marketplace.visualstudio.com/items?itemName=harsh-lang.harsh-lang", target: "_blank", rel: "noopener", code { "harsh-lang" } }
                ", on the Marketplace: highlighting, indentation on Enter and Tab, formatting, "
                "and diagnostics on save, through " code { "hrs-lsp" } " -- installed with "
                code { "harsh-lang" } " above. Search " em { "Harsh" } " in the Extensions view, or:"
            }
            Code { code: VSCODE, lang: "shell" }
            p { class: "dim",
                "For VSCodium, Cursor and the other editors built on VS Code, the same extension "
                "on Open VSX is coming."
            }

            h3 { "Jupyter" }
            p {
                "A Harsh kernel for notebooks: each cell is transpiled by " code { "hrs" }
                " and run by evcxr, Rust's own Jupyter kernel, which it needs; an error points "
                "at the cell's own line. Then pick " em { "Harsh" } " in Jupyter."
            }
            Code { code: JUPYTER, lang: "shell" }
            p { class: "dim",
                "Use " code { "python -m" } " for each Python command, so pip, the kernel and "
                "Jupyter are one Python. Matrices work in notebooks too: the first cell that "
                "uses them takes a minute or two while nalgebra compiles."
            }

            h3 { "Zed -- coming" }
            p {
                "A Zed extension and a tree-sitter grammar for Harsh are written and in the "
                "repository, " code { "editors/" } "; they go to the Zed extension registry "
                "once two indentation issues in Zed are settled. Until then, Zed can open "
                code { ".hrs" } " files as plain text."
            }

            h3 { "Other editors" }
            p {
                code { "hrs-lsp" } " is a language server: any editor that speaks LSP -- Neovim, "
                "Helix, Emacs -- can run it for formatting, indentation and diagnostics. The "
                "tree-sitter grammar, in the repository, gives them highlighting."
            }

            h3 { "Harshlings" }
            p {
                "Small exercises, broken on purpose, to learn Harsh by fixing them -- as "
                "Rustlings does for Rust. 65 of them, with hints and solutions."
            }
            Code { code: HARSHLINGS, lang: "shell" }

            h2 { "Bringing existing Rust in" }
            p {
                code { "hrs-from" } " converts a Rust file, or a whole project, to Harsh -- "
                "including a Leptos or Dioxus site, whose " code { "view!" } " and "
                code { "rsx!" } " bodies stay as written with the Rust in them turned into Harsh holes. "
                "The round trip is byte-exact: it is how the transpiler's own source is tested."
            }
        }
    }
