fn double n: i32 -> i32:
    n * 2

fn show n: i32 -> String:
    format! "<{n}>"

fn sub a: i32 -> impl Fn i32 -> i32:
    move |b| a - b

fn main$:
    // backward: function on the left, one atom
    let a = double <| 21
    // right-associative chain
    let b = show <| double <| 3
    // forward: value on the left
    let c = 5 |> double
    // left-associative chain
    let d = 5 |> double |> show
    // inside an argument
    let e = show (double <| 4)
    // the two groupings apply arguments in opposite orders
    let f = (3 |> sub) 100
    let g = 3 |> (sub 100)
    println! "{a} {b} {c} {d} {e} {f} {g}"
