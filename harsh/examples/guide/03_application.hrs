fn two (a: i32) (b: i32) -> i32:
    a - b

fn one x: i32 -> i32:
    x * 10

fn tup (p: (i32, i32)) -> i32:
    p.0 + p.1

fn takes_unit (u: ()) -> i32:
    let _ = u
    99

fn main$:
    // juxtaposition
    let a = two 7 3
    // isolating parens around a non-atom argument
    let b = two (a + 1) (one 2)
    // a parenthesised group with commas is a tuple: one argument
    let c = tup (4, 5)
    // zero arguments
    let d = one (two 1 1)
    // unit as a value, not an empty argument list
    let e = takes_unit ()
    // a call as the head of another call
    let f = (one) 3
    println! "{a} {b} {c} {d} {e} {f}"
