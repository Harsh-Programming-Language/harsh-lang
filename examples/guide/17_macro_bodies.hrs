// Both sides of a macro are Harsh: the matcher a parameter list, the
// transcriber a block.
macro_rules~ twice:
    ($e:expr) => do: $e * 2

macro_rules~ my_vec:
    ( $( ($x:expr) )* ) => do:
        do:
            let mut v = Vec.new$
            $(v <- push $x)*
            v

macro_rules~ hashmap:
    ( $( ($k:expr => $v:expr) )* ) => do:
        do:
            let mut m = std.collections.HashMap.new$
            $(
                let k = $k
                m <- insert k $v
            )*
            m

macro_rules~ log:
    ( ($level:expr) $($arg:tt)* ) => do:
        println! "[{}] {}" $level (format! $($arg)*)

macro_rules~ filled:
    [ $elem:expr ; $n:expr ] => do:
        vec! [$elem; $n]

// A macro body: `name! do:`, a Harsh block by default.
macro_rules~ first_of:
    ( $($t:tt)* ) => do:
        match ($($t)*): (a, _) => a

fn main$:
    let v = my_vec~ 1 2 3
    let m = hashmap~ ("a" => 1) ("b" => 2)
    log~ "info" "{} items, {} keys" (v <- len$) (m <- len$)
    let z = filled~ [0u8; 2]
    let f = first_of~ do:
        (twice~ 4, 0)
    println! "{v:?} {} {z:?} {f}" (m["b"])
