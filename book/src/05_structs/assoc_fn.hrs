#[derive Debug]
struct Rectangle
    width: u32
    height: u32

impl Rectangle:
    fn square size: u32 -> Self:
        Self\ width = size, height = size

impl Rectangle:
    fn area (&self) -> u32:
        self <- width * self <- height

fn main$:
    let sq = Rectangle.square 3
    println! "{:?} has area {}" sq (sq <- area$)
