fn main$:
    let n = 7

    if n % 2 == 0:
        println! "even"
    else:
        println! "odd"
    // `if` is an expression: it produces a value, and both arms must agree on its type.

    let kind = if n > 5: "big" else: "small"
    println! "{}" kind

    let sign =
        if n > 0:
            1

        else if n < 0:
            -1

        else:
            0

    println! "{}" sign
