{
  "grammars": [
    {
      "name": "harsh",
      "camelcase": "Harsh",
      "scope": "source.harsh",
      "path": ".",
      "file-types": [
        "hrs"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^harsh$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MPL-2.0",
    "description": "Tree-sitter grammar for Harsh \u2014 Rust with indentation instead of braces.",
    "links": {
      "repository": "https://github.com/Harsh-Programming-Language/tree-sitter-harsh"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
