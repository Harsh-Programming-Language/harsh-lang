#[derive PartialEq Debug Clone]
struct P
    x: i32
    y: i32
fn f<T>(x: T) -> T where T: Clone + Send:
    x
fn g<T, U>(a: T) (b: U) -> String where T: std.fmt.Debug, U: std.fmt.Display:
    format! "{a:?} {b}"
fn h$ -> i32:
    match (P\ x = 1, y = 2)\
        P\ x, y => x + y
fn i (p: P) -> i32:
    if (p == P\ x = 1, y = 2):
        1
    else:
        0
fn main$:
    println! "{} {} {} {}" (f 7) (g 1 "a") (h$) (i (P\ x = 1, y = 2))
