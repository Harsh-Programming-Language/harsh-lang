fn a (n: i32) -> &'static str:
    // indented
    if n < 0:
        "neg"
    else if n == 0:
        "zero"
    else:
        "pos"

fn b (n: i32) -> &'static str:
    // inline, one line
    if n < 0: "neg" else: if n == 0: "zero" else: "pos"

fn c (n: i32) -> &'static str:
    // braced
    if n < 0 { "neg" } else if n == 0 { "zero" } else { "pos" }

fn d (a: bool) (b: bool) -> i32:
    // nearest else
    if a: if b: 1 else: 2 else: 3

fn e (a: bool) (b: bool) -> i32:
    // braces select the outer binding
    if a: if b { 1 } else { 0 } else: 2

fn f (v: Option<i32>) -> i32:
    // if let, indented
    if let Some n = v:
        n
    else:
        -1

fn g (v: Option<i32>) -> i32:
    // if let, inline
    if let Some n = v: n else: -1

fn h (v: Option<i32>) -> i32:
    // as a value in a let
    let r = if let Some n = v: n * 2 else: 0
    r

fn main$:
    println!
        "{} {} {} {} {} {} {} {}"
        (a (-1))
        (b 0)
        (c 5)
        (d true false)
        (e true false)
        (f (Some 4))
        (g None)
        (h (Some 3))
