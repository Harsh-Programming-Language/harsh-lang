use std.collections.HashMap
use std.fmt
use std.io.(self, Write)
use std.collections.(
        BTreeMap,
        HashSet,
    )

mod geo
    pub struct V
        pub x: f64

fn main$:
    // path separator
    let m = HashMap<String, i32>.new$
    let b = BTreeMap<i32, i32>.new$
    let s = HashSet<i32>.new$
    let v = geo.V\ x = 1.0
    let e = String.from "e"
    // a generic call needs no turbofish
    let parsed = "42" <- parse<i32>$ <- unwrap$
    let mut out = std.io.stdout$
    let _ = out <- flush$
    println!
        "{} {} {} {} {} {}"
        (m <- len$)
        (b <- len$)
        (s <- len$)
        (v <- x)
        e
        parsed
