use dioxus.prelude.*

use crate.app.Route
use crate.components.Wordmark

const LOGO: Asset = asset! "/assets/favicon.png"

/// The site's navbar, on every page. The bar itself (`.nav`) is the same
/// everywhere; around it, a full-width band (`.bar`) that on the home page
/// lies over the jumbotron's image, translucent and blurring it (`over`).
/// On phones the links fold into a menu behind a three-line button (`open`).
#[component]
pub fn Nav$ -> Element:
    let over = use_route.<Route>$ == Route.Home {}
    let mut open = use_signal (|| false)
    use_effect ||:
        let _ = document.eval ESCAPE_CLOSES
    rsx! {
        header { class: @: bar_class over (open$) :@,
            div { class: "nav",
                Link { class: "brand", to: Route::Home {},
                    img { src: LOGO, alt: "", class: "brand-logo" }
                    Wordmark {}
                }
                button {
                    class: "menu",
                    aria_label: "Menu",
                    aria_expanded: "{open}",
                    aria_controls: "site-links",
                    onclick: @: move |_| open <- set (!open$) :@,
                    span {}
                    span {}
                    span {}
                }
                // A click on any link closes the phone menu.
                nav { id: "site-links", onclick: @: move |_| open <- set false :@,
                    Link { to: Route::Home {}, "Home" }
                    Link { to: Route::Learn {}, "Learn" }
                    Link { to: Route::Install {}, "Install" }
                    Link { to: Route::Converter {}, "Converter" }
                    Link { to: Route::Playground {}, "Playground" }
                    a { href: "https://gitlab.com/bahiminin.benoit.dah.opensource/harsh-lang", target: "_blank", rel: "noopener", "GitLab" }
                    a { href: "https://github.com/Harsh-Programming-Language/harsh-lang", target: "_blank", rel: "noopener", "GitHub" }
                }
            }
        }
    }

/// The band's classes: `over` on the home page, `open` while the phone
/// menu is open.
fn bar_class (over: bool) (open: bool) -> String:
    let mut class = String.from "bar"
    if over:
        class <- push_str " over"
    if open:
        class <- push_str " open"
    class

/// Escape closes the phone menu, as the button would.
const ESCAPE_CLOSES: &str = r#"
document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") document.querySelector(".bar.open .menu")?.click();
});
"#
