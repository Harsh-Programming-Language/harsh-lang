fn largest_i32 list: &[i32] -> &i32:
    let mut largest = &list[0]

    for item in list:
        if item > largest:
            largest = item

    largest

fn largest_char list: &[char] -> &char:
    let mut largest = &list[0]

    for item in list:
        if item > largest:
            largest = item

    largest

fn main$:
    println! "{}" (largest_i32 (&[34, 50, 25, 100, 65]))
    println! "{}" (largest_char (&['y', 'm', 'a', 'q']))
