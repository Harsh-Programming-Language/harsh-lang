struct P
    x: i32
    y: i32

impl P:
    fn norm (&self) -> i32:
        self <- x * self <- x + self <- y * self <- y

fn main$:
    let p = P\ x = 3, y = 4
    let v = vec! [3, 1, 2]
    // spaced, tight, and mixed are identical
    let a = p <- x
    let b = p<-y
    let c = v <- len$<-to_string$
    // a vertical chain: each <- on its own line
    let d = v
        <- iter$
        <- map (|n| n * 2)
        <- sum<i32>$
    // horizontal chain
    let e =
        v <- iter$
          <- max$
          <- copied$
          <- unwrap_or 0
    // tuple index and float keep their dot
    let t = (1, 2.5)
    println! "{a} {b} {c} {d} {e} {} {} {}" (p <- norm$) (t.0) (t.1)
