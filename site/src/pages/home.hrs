use dioxus.prelude.*

use crate.app.Route
use crate.components.( Code, Compare, Wordmark)
use crate.samples.*

const BRACES: &str = r#"I(would, like, to, go) {
    to the market so I(could buy) {
        some groceries
    }
    to the laundromat in order to(get) {
        clothes washed
    }
}"#

const NO_BRACES: &str = r#"I would like to go
    to the market so I could buy
        some groceries
    to the laundromat in order to get
        clothes washed"#

/// The jumbotron's four boxes: they take turns in one place, forever --
/// typed, held, erased (`TYPING`). Each line is a title or an item.
const BOXES: &[&[(&str, &str)]] = &[
    &[("title", "Rust without the braces")],
    &[("title", "Functional Programming"), ("item", "Comprehensions, Pipes,"), ("item", "and Partial Functions")],
    &[("title", "Linear Algebra"), ("item", "Vectors, Matrices,"), ("item", "and Matrix Arithmetic")],
    &[("title", "Artificial Intelligence"), ("title", "& Data Science")],
]

#[component]
pub fn Home$ -> Element:
    use_effect ||:
        let _ = document.eval TYPING
    rsx! {
        section { class: "jumbo",
            div { class: "jumbo-inner",
                h1 { class: "sr-only",
                    "Harsh: Rust without the braces. Functional programming: comprehensions, pipes "
                    "and partial functions. Linear algebra: vectors, matrices and matrix arithmetic. "
                    "Artificial intelligence and data science."
                }
                div { class: "stage", aria_hidden: "true",
                    for (n, lines) in @: BOXES <- iter$ <- enumerate$ :@ {
                        p { class: @: if n == 0: "box on" else: "box" :@,
                            for (kind, text) in @: lines <- iter$ :@ {
                                span { class: "line {kind}", "data-text": "{text}",
                                    span { class: "typed" }
                                    span { class: "ghost", "{text}" }
                                }
                            }
                        }
                    }
                }
                div { class: "cta",
                    Link { class: "button primary", to: Route::Install {}, "Get started" }
                    Link { class: "button", to: Route::Converter {}, "Convert Harsh to Rust" }
                }
            }
        }

        div { class: "home-wrap",
            section { class: "first-look",
                p { class: "hero-tag",
                    "A layout transformation over Rust: indentation instead of braces, "
                    "and four things Rust has no syntax for -- pipes, partial application, "
                    "comprehensions and linear algebra. Every Rust crate works unchanged."
                }
                Compare { harsh: HERO_HARSH, rust: HERO_RUST }
            }

            section { class: "why",
                h2 { "Why no braces" }
                p {
                    "Here is what a brace language looks and reads like, once you notice it, "
                    "and the message it was trying to convey:"
                }
                div { class: "compare",
                    div { class: "pane", pre { class: "code plain", "{BRACES}" } }
                    div { class: "pane", pre { class: "code plain", "{NO_BRACES}" } }
                }
                p {
                    "The second is already in the first -- the indentation was there all along; "
                    "the braces and parentheses only repeat it, in a form the eye has to skip past. "
                    "Harsh weeds out the braces to let Rust shine."
                }
                blockquote {
                    p { "Braces are for the compiler; indentation is for humans." }
                    footer { "-- Claude, asked early in the work to justify removing braces from Rust at all" }
                }
            }

            section { class: "features",
                h2 { "What Harsh adds" }
                p {
                    "Braces are where Harsh starts, not where it stops. It adds four things "
                    "Rust has no syntax for -- and they are the reason to use it."
                }

                article {
                    h3 { "Pipes and partial application" }
                    p {
                        "Give a function fewer arguments than it takes, and you get a function "
                        "waiting for the rest. "
                        code { "|>" } " fills parameters from the left, "
                        code { "<|" } " from the right; the closure is flat and costs nothing at runtime."
                    }
                    Compare { harsh: PIPES_HARSH, rust: PIPES_RUST }
                }

                article {
                    h3 { "Generator comprehensions" }
                    p {
                        "Say what a collection holds, not how to fill it. "
                        code { "g~" } " is lazy; " code { "list~" } ", " code { "set~" } " and "
                        code { "dict~" } " collect it. Each " code { "if" } " belongs to the "
                        code { "for" } " before it."
                    }
                    Compare { harsh: COMPREHENSIONS_HARSH, rust: COMPREHENSIONS_RUST }
                }

                article {
                    h3 { "Linear algebra, as in Julia" }
                    p {
                        "Julia's matrix literal, Julia's " code { "*" } ", slicing and broadcasting, "
                        "and " code { "f<> a" } " for " code { "f.(a)" } " -- on nalgebra, "
                        "through " code { "hrs_std" } "."
                    }
                    Compare { harsh: LINALG_HARSH, rust: LINALG_RUST }
                }
            }

            section { class: "rust",
                h2 { "Everything Rust has" }
                p {
                    "Harsh is a superset of Rust. It states rules only for what it changes; "
                    "wherever it is silent, Rust's rules apply, and braces mean what they mean in Rust. "
                    "There is no semantic model in the transpiler -- generics, lifetimes, "
                    code { "async" } ", " code { "unsafe" } ", and Rust syntax that does not exist yet "
                    "pass through untouched. Every Rust crate works unchanged, and "
                    code { "hrs-from" } " converts existing Rust to Harsh -- byte-exact on the way back."
                }
                div { class: "cards",
                    Link { class: "card", to: Route::Learn {},
                        h3 { "Learn" }
                        p { "The Harsh Book, Harsh by Example, the language guide, and Harshlings." }
                    }
                    Link { class: "card", to: Route::Install {},
                        h3 { "Install" }
                        p { "One " code { "cargo install" } ". Then " code { "hrs new" } " and " code { "hrs run" } "." }
                    }
                    Link { class: "card", to: Route::Converter {},
                        h3 { "Converter" }
                        p { "Harsh to Rust in the browser, and a Run button for the Rust." }
                    }
                    Link { class: "card", to: Route::Playground {},
                        h3 { "Playground" }
                        p { "Write Harsh, press Run, read what it prints." }
                    }
                }
                p { class: "dim", "Rust for functional programming, data science and machine learning." }
                Code { code: "#[Ha<rs>.h]", lang: "harsh" }
            }
        }
    }

/// The jumbotron's boxes, in turn: each typed a character at a time, held,
/// erased from its end, then the next; forever. The page does not move --
/// every box keeps its full size, invisibly (`.ghost`). With reduced motion,
/// each box is shown whole, in turn. Leaving the page stops the loop, so
/// coming back does not start a second one.
const TYPING: &str = r#"
const run = (window.__harshTyping = (window.__harshTyping || 0) + 1);
const alive = () => window.__harshTyping === run && document.querySelector(".jumbo .box");
const boxes = [...document.querySelectorAll(".jumbo .box")];
const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
const TYPE = 38, ERASE = 14, HOLD = 2600, GAP = 350;
const lines = (box) => [...box.querySelectorAll(".line")];
const fill = (el, n) => {
    const t = el.dataset.text;
    el.querySelector(".typed").textContent = t.slice(0, n);
    el.querySelector(".ghost").textContent = t.slice(n);
};
const show = (k) => boxes.forEach((b, j) => b.classList.toggle("on", j === k));
boxes.forEach((b) => lines(b).forEach((el) => fill(el, 0)));
const later = (f, ms) => setTimeout(() => { if (alive()) f(); }, ms);
if (still) {
    boxes.forEach((b) => lines(b).forEach((el) => fill(el, el.dataset.text.length)));
    let k = 0;
    show(0);
    const turn = () => { k = (k + 1) % boxes.length; show(k); later(turn, HOLD + 1400); };
    later(turn, HOLD + 1400);
} else {
    const type = (box, done) => {
        const ls = lines(box);
        let i = 0;
        const nextLine = () => {
            if (i >= ls.length) { ls[ls.length - 1].classList.add("typing"); return later(done, HOLD); }
            const el = ls[i], t = el.dataset.text;
            let n = 0;
            el.classList.add("typing");
            const step = () => {
                fill(el, n);
                if (n < t.length) { n++; later(step, TYPE); }
                else { if (i < ls.length - 1) el.classList.remove("typing"); i++; later(nextLine, 180); }
            };
            step();
        };
        nextLine();
    };
    const erase = (box, done) => {
        const ls = lines(box).reverse();
        let i = 0;
        const nextLine = () => {
            if (i >= ls.length) return later(done, GAP);
            const el = ls[i];
            let n = el.dataset.text.length;
            ls.forEach((x) => x.classList.remove("typing"));
            el.classList.add("typing");
            const step = () => {
                fill(el, n);
                if (n > 0) { n--; later(step, ERASE); }
                else { el.classList.remove("typing"); i++; nextLine(); }
            };
            step();
        };
        nextLine();
    };
    let k = 0;
    const cycle = () => { show(k); type(boxes[k], () => erase(boxes[k], () => { k = (k + 1) % boxes.length; cycle(); })); };
    later(cycle, 400);
}
"#
