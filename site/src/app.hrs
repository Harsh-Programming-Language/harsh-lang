use dioxus.prelude.*

use crate.components.( Footer, Nav)
use crate.pages.( Converter, Home, Install, Learn, NotFound, Playground)

const CSS: Asset = asset! "/assets/main.css"
const FAVICON: Asset = asset! "/assets/favicon.png"

/// The site's pages. Every page sits inside `Shell`, which draws the
/// navigation and the footer around it.
#[derive Routable Clone PartialEq]
#[rustfmt.skip]
pub enum Route
    #[layout Shell]
    #[route "/"]
    Home {}
    #[route "/learn"]
    Learn {}
    #[route "/install"]
    Install {}
    #[route "/converter"]
    Converter {}
    #[route "/playground"]
    Playground {}
    #[route "/:..segments"]
    NotFound
        segments: Vec<String>

#[component]
pub fn App$ -> Element:
    rsx! {
        document::Link { rel: "icon", href: FAVICON }
        document::Stylesheet { href: CSS }
        Router::<Route> {}
    }

#[component]
fn Shell$ -> Element:
    // The home page's jumbotron spans the whole window: there, `main` drops
    // its width limit, and the page keeps its other sections to the width.
    let home = use_route<Route>$ == Route.Home {}
    // The arrow shows once the page has scrolled past a screen or so.
    use_effect ||:
        let _ = document.eval SHOW_ARROW
        let _ = document.eval COPY_BUTTONS
    rsx! {
        Nav {}
        main { class: @: if home: "full" else: "" :@, Outlet::<Route> {} }
        Footer {}
        button {
            class: "to-top",
            title: "Back to the top",
            aria_label: "Back to the top",
            onclick: @: move |_| to_top$ :@,
            "↑"
        }
    }

/// Show the back-to-top arrow only when there is somewhere to go back to.
const SHOW_ARROW: &str = r#"
const arrow = document.querySelector(".to-top");
const update = () => arrow.classList.toggle("shown", window.scrollY > 400);
window.addEventListener("scroll", update, { passive: true });
update();
"#

/// Back to the top of the page, smoothly unless the reader asked for less motion.
fn to_top$:
    let _ = document.eval TO_TOP

const TO_TOP: &str = r#"
const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
window.scrollTo({ top: 0, behavior: still ? "auto" : "smooth" });
"#

/// A discreet copy button on every code block, on every page.
const COPY_BUTTONS: &str = r#"
// A discreet copy button on every code block (the user's, 2026-09-27): shown
// on hovering the block; copies the block's text; says so for a moment.
// Editors are left alone -- their text is the textarea's.
(function(){
  function add(pre){
    if (pre.dataset.copy || pre.classList.contains('editor-view')) return;
    pre.dataset.copy = '1';
    var b = document.createElement('button');
    b.className = 'copy'; b.type = 'button'; b.textContent = 'Copy';
    b.title = 'Copy the code'; b.setAttribute('aria-label', 'Copy the code');
    b.addEventListener('click', function(){
      var text = pre.innerText.replace(/Copy(ied)?$/, '').replace(/\n$/, '');
      var done = function(){ b.textContent = 'Copied'; setTimeout(function(){ b.textContent = 'Copy'; }, 1400); };
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, function(){});
    });
    pre.appendChild(b);
  }
  function all(){ document.querySelectorAll('pre.code').forEach(add); }
  all();
  new MutationObserver(all).observe(document.body, { childList: true, subtree: true });
})();
"#
