pub fn add_two a: u64 -> u64:
    a + 2

#[cfg test]
mod tests:
    use super.*

    #[test]
    fn add_two_and_two$:
        assert_eq! 4 (add_two 2)

    #[test]
    fn add_three_and_two$:
        assert_eq! 5 (add_two 3)

    #[test]
    fn one_hundred$:
        assert_eq! 102 (add_two 100)

    #[test]
    #[ignore]
    fn expensive_test$:
        // takes an hour; run with `cargo test -- --ignored`
        assert_eq! 2 (add_two 0)
